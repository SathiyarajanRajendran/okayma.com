/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

# Assets and the self-hosted fonts are content-stable. Fonts need no CORS
# header: they are same-origin, and `rel=preload as=font crossorigin` succeeds
# same-origin without one.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# CSS and JS revalidate on every request (cheap 304s). These filenames are not
# content-hashed, so a long max-age could leave a visitor running yesterday's
# script against today's markup after a deploy.
#
# `no-cache` rather than `max-age=0`: Cloudflare's zone-level Browser Cache TTL
# overrides an origin max-age, and was rewriting these to 14400 in production —
# four hours during which a returning visitor kept the previous deploy's script.
# no-cache is not rewritten, and means the same thing here: store it, but check
# with the origin before using it.
/styles.css
  Cache-Control: no-cache

/board.css
  Cache-Control: no-cache

/ideas.js
  Cache-Control: no-cache

/site.js
  Cache-Control: no-cache

/testimonials.js
  Cache-Control: no-cache

/admin.js
  Cache-Control: no-store

/admin
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/admin.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/api/*
  Cache-Control: no-store

/*.html
  Cache-Control: no-cache
